# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Moved to the private starl3xx/walletlink-ops repo. Kept on disk so the
# ralph:* content scripts keep working locally, but no longer tracked here:
# the security runbook maps where every secret lives, and the drafts are
# unpublished positioning. See docs/README.md.
#
# The runbook pattern below is anchored by its slash, so it ignores only the
# old internal runbook under docs/ and nothing at the root. The root
# SECURITY.md is the public vulnerability policy, a different document that
# must stay tracked. Never widen the pattern to the bare file name;
# scripts/check-invariants.ts asserts both halves.
docs/SECURITY.md
content/drafts/
data/content.db
