{
  "name": "wallet-to-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:design": "node scripts/check-design-language.mjs",
    "check:style": "node scripts/check-house-style.mjs",
    "check:palette": "node scripts/check-palette-guard.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:og": "node scripts/check-og-palette.mjs",
    "check:invariants": "npx tsx scripts/check-invariants.ts",
    "gen:secret-box-key": "npx tsx scripts/gen-secret-box-key.ts",
    "pr:status": "npx tsx scripts/pr-status.ts",
    "check:invariants-guard": "npx tsx scripts/check-invariants-guard.ts",
    "check:figures": "npx tsx --env-file=.env.local scripts/check-published-figures.ts",
    "check:height": "node scripts/check-control-height.mjs",
    "growth:report": "npx tsx --env-file=.env.local scripts/growth-report.ts",
    "preflight": "prettier --check . && npm run typecheck && npm run check:palette && npm run check:design && npm run check:style && npm run check:contrast && npm run check:og && npm run check:invariants && npm run check:social && npm run check:outreach",
    "db:generate": "drizzle-kit generate",
    "db:push": "node scripts/db-push-refuses.mjs",
    "db:push:unsafe": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ralph:init": "node src/db/init.js",
    "ralph:seed": "node src/db/seed.js",
    "ralph:reset": "rm -f data/content.db && npm run ralph:init && npm run ralph:seed",
    "ralph:status": "node src/db/status.js",
    "ralph:content": "node src/content/list.js",
    "ralph:test": "node src/test.js",
    "check:social": "npx tsx scripts/check-social-queue.ts",
    "outreach": "node scripts/outreach/cli.mjs",
    "outreach:worker": "node scripts/outreach/worker.mjs",
    "check:outreach": "node --test scripts/outreach/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/analytics": "^2.0.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "ethers": "^6.16.0",
    "gray-matter": "^4.0.3",
    "inngest": "^4.26.0",
    "marked": "^18.1.1",
    "mcp-handler": "^2.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "^9.3.12",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "sql.js": "^1.15.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    },
    "@x402/core": {
      "zod": "$zod"
    },
    "@x402/evm": {
      "zod": "$zod"
    },
    "inngest": {
      "zod": "$zod"
    }
  }
}
