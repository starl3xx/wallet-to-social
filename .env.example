# Neon Postgres database URL (from Vercel/Neon dashboard)
DATABASE_URL=

# Use the pooled driver instead of the HTTP one. Production sets this.
#
# It decides which driver `getDb()` returns, and the two differ in more than
# speed: `neon-http` cannot run a transaction, and answers `db.transaction()`
# with a throw at call time rather than at build time. Leaving this unset used
# to make every social-graph write fail on any environment that did not set it,
# which is invisible until you read `lookup_jobs.social_graph_write_errors`.
# The write path now degrades to sequential statements instead of throwing, so
# an unset value costs atomicity rather than the data, but set it anyway: the
# pooler is also what takes p95 from 200-500ms to 50-100ms.
USE_CONNECTION_POOLING=true

# Web3.bio API key for faster lookups
WEB3BIO_API_KEY=

# Neynar API key for Farcaster lookups (optional but recommended)
# Get your key at https://neynar.com
NEYNAR_API_KEY=

# Alchemy API key for reliable ENS lookups (optional)
# Get your key at https://www.alchemy.com
ALCHEMY_KEY=

# Moralis API key for ERC-20 token holder lookups (required for contract import feature)
# Get your key at https://moralis.io
MORALIS_API_KEY=

# Stripe - for credit packs (optional)
# Get your keys at https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-mode key, only needed to run scripts/create-test-packs.ts. Kept separate
# from the live key so both can sit here at once: swapping one variable back and
# forth is how the wrong key ends up in place afterwards.
STRIPE_TEST_SECRET_KEY=
# Legacy one-time tiers. Still live: both existing paying accounts were
# provisioned through this path, and the upgrade modal is cached in browsers.
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=
# Credit packs, the current product. One-off prices, not recurring: a recurring
# price makes Stripe reject a mode: 'payment' session at creation time.
STRIPE_PRICE_PACK_TRIAL=
STRIPE_PRICE_PACK_CAMPAIGN=
STRIPE_PRICE_PACK_SCALE=
STRIPE_PRICE_PACK_INDEX=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_URL=http://localhost:3000

# Admin password for whitelist management
ADMIN_PASSWORD=

# X account resolver. Both are required for the handle-liveness sweep and for
# resolving account ids in the Clanker adapter; without them each degrades
# rather than guessing. Named neutrally on purpose: this repo is public, and
# CLAUDE.md's rule is that we never put a data supplier's identity in it.
X_RESOLVER_API_BASE=
X_RESOLVER_API_KEY=

# Handle conflict resolver: X lookups it may spend per daily run re-checking
# stale or unchecked handles before accepting a replacement (default 300).
CONFLICT_RECHECK_CREDITS=300

# Lifecycle email (announcements, sequences; distinct from magic-link mail).
# The unsubscribe links are stateless HMACs over the address with this
# secret. Set the SAME value locally (where campaign scripts run) and in
# Vercel (where the unsubscribe endpoint verifies), or delivered links will
# not verify. Lifecycle sends refuse to run without it.
EMAIL_UNSUBSCRIBE_SECRET=

# Casting as @walletlink on Farcaster (scripts/setup-farcaster-signer.ts,
# scripts/cast-farcaster.ts). The mnemonic signs one local message during
# setup and is never transmitted; keep it in .env.local only, never Vercel.
FARCASTER_WALLETLINK_MNEMONIC=
NEYNAR_SIGNER_UUID=

# X search for the DeBank binding-tweet harvest
# (scripts/harvest-debank-bindings.ts). An api.twitterapi.io key; the script
# refuses to run without it and stops cleanly when its credits run out.
TWITTERAPI_IO_KEY=

# OpenSea account enrichment (scripts/enrich-opensea-accounts.ts) and the
# collection seeding fallback. Seeding can auto-provision a temp key; the
# enrichment script requires this one.
OPENSEA_API_KEY=

# The onchain rail (x402). Unset means /api/x402/buy answers 503, which is the
# default: a payment rail with a default address is a rail that pays somebody
# else. Set to a Base mainnet address you control.
X402_PAY_TO=
# Signs the key-recovery challenge. Unset means /api/x402/recover answers 503,
# so a buyer who loses their key has no self-serve route back. Its own secret
# rather than a reuse: rotating it invalidates only recovery challenges, and
# invalidates every one in flight.
X402_RECOVERY_SECRET=
# Optional. Defaults to a facilitator that serves protocol v2 on Base mainnet.
# Before changing it, curl its /supported and require a kind with
# x402Version: 2, network: eip155:8453 and scheme: exact.
X402_FACILITATOR_URL=

# Encrypts the one class of secret this system has to read back: an outbound
# OAuth token held on a user's behalf. Everything else here is hashed, because
# everything else is only ever recognised, never replayed. See lib/secret-box.ts.
#
# 32 bytes, base64 or hex. Generate one with:
#   npm run gen:secret-box-key
#
# Unset means lib/secret-box.ts refuses to seal rather than storing a plaintext
# token, and every feature that holds a third-party token stays unavailable.
# Rotating it makes every stored token unopenable, which logs those connections
# out and requires reconnecting; it is the right response to a suspected leak of
# the database, and the reason it is its own secret rather than a reuse of
# X402_RECOVERY_SECRET or EMAIL_UNSUBSCRIBE_SECRET.
SECRET_BOX_KEY=
# walletlink as an OAuth client of X, for writing a list into a user's own
# account. Register a confidential client in the X developer portal with the
# callback https://walletlink.social/api/x/callback and the scopes
# users.read tweet.read list.read list.write.
#
# offline_access is deliberately NOT requested: a refresh token is a standing
# ability to act as that person, and this feature needs a token for the ~16
# minutes a list takes to build, not for ever. See lib/x-oauth.ts.
#
# Unset means /api/x/connect answers 503 rather than starting a flow it cannot
# finish. Writing members also spends prepaid X API credits, so an app with no
# balance fails partway through a list rather than at the start.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# The /claim flow: proving a wallet and an X account are the same person.
#
# ATTESTATION_SECRET signs the challenge a wallet signs. It is deliberately
# NOT X402_RECOVERY_SECRET: two flows now ask a wallet to sign and they
# authorize different things, so a signature captured for one must be refused
# by the other. Rotating either must not silently invalidate the other's
# challenges. Unset means /api/claim/* answers 503.
#
# ATTESTATION_ID_PEPPER keys the HMAC of the X account id that enforces one
# grant per account, ever. It has to keep working after a withdrawal erases
# the plaintext, which is the whole point of a withdrawal, so the uniqueness
# key cannot be the identity. Unkeyed would not do: an account id is a short
# number from a small space and a bare digest of one is reversible by anybody
# who can count. Falls back to ATTESTATION_SECRET when unset, which works and
# means rotating that secret orphans existing grant keys; set it separately in
# production.
ATTESTATION_SECRET=
ATTESTATION_ID_PEPPER=
