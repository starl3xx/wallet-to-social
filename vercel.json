{
  "crons": [
    {
      "path": "/api/jobs/worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/refresh-stale",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/refresh-coverage",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/farcaster-sweep",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/ens-harvest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/seed-collections",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/ethos-sweep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/eas-sweep",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/cron/clanker-sweep",
      "schedule": "40 6 * * *"
    },
    {
      "path": "/api/cron/graph-repair",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/x-reachability",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/resolve-conflicts",
      "schedule": "40 8 * * *"
    },
    {
      "path": "/api/cron/welcome-sequence",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/checkin-nonbuyers",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/welcome-first",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
